---
const { lang = "en" } = Astro.props;

const EMAIL = "duarte.ezequieldd@gmail.com";
const SUBJECT = lang === "es" ? "Portfolio — Conectemos" : "Portfolio — Let's connect";
const mailto = `mailto:${EMAIL}?subject=${encodeURIComponent(SUBJECT)}`;

const SOCIAL = {
  instagram: "https://www.instagram.com/_zeki_to/",
  linkedin: "https://www.linkedin.com/in/ezequiel-duarte/",
  github: "https://github.com/Zek1t0",
};

const copy = {
  en: {
    heading: "Let's Connect",
    pill: "Open to connect",
    pitch:
      "Whether you have a cool project idea, a question, or just want to say hi, I'm always happy to chat!",
    tags: ["Work proposals", "Networking", "Project ideas", "Friends"],
    ctaPrimary: "Get in touch!",
    ctaEmailTitle: "Send me an email",
    socialNote: "If you prefer social media, follow me below — I’m always open to connect.",
    rightTitle: "Let's stay connected",
    rightDesc: "Follow me for projects and updates, or reach out if you want to collaborate.",
    bestChannel: "Best channel: Email",
    rightMessage:
      "Looking for a developer? Want to network? Have a project idea? Send me an email — I reply as soon as I can.",
    reachOutTitle: "What you can reach out for",
    bullets: [
      "Job opportunities / freelance proposals",
      "Networking and meeting new people",
      "Collaborations and building projects",
      "Just saying hi / making friends",
    ],
  },
  es: {
    heading: "Conectemos",
    pill: "Hablemos!",
    pitch:
      "Si tenés una idea copada de proyecto, una pregunta o simplemente querés saludar, siempre estoy para charlar.",
    tags: ["Propuestas de trabajo", "Networking", "Ideas de proyecto", "Amigos"],
    ctaPrimary: "Contactame",
    ctaEmailTitle: "Mandame un mail",
    socialNote: "Si preferís redes, seguime abajo — siempre estoy abierto a conectar.",
    rightTitle: "Sigamos en contacto",
    rightDesc: "Seguime para ver proyectos y novedades, o escribime si querés colaborar.",
    bestChannel: "Mejor canal: Email",
    rightMessage:
      "¿Buscás un dev? ¿Querés hacer networking? ¿Tenés una idea? Mandame un mail — respondo apenas pueda.",
    reachOutTitle: "Para qué podés escribirme",
    bullets: [
      "Oportunidades laborales / propuestas freelance",
      "Networking y conocer gente nueva",
      "Colaboraciones y armar proyectos",
      "Solo saludar / hacer amistad",
    ],
  },
};

const t = lang === "es" ? copy.es : copy.en;
---

<section
  id="contact"
  class="w-full py-12 sm:py-14 md:py-24 bg-gradient-to-b from-amber-50 to-white dark:from-gray-900 dark:to-gray-800 text-gray-800 dark:text-gray-200"
>
  <div class="max-w-6xl mx-auto px-4">
    <h2 class="text-4xl font-bold tracking-tighter sm:text-5xl text-center mb-8 sm:mb-10 text-cerise-600 dark:text-emerald-400">
      {t.heading}
    </h2>

    <div class="relative overflow-hidden rounded-[32px] border border-amber-200/80 dark:border-gray-700 bg-white/60 dark:bg-gray-900/30 shadow-xl">
      <!-- Background accents -->
      <div class="absolute inset-0 pointer-events-none">
        <div class="absolute -top-28 -right-20 w-72 h-72 rounded-full bg-cerise-500/10 blur-3xl dark:bg-emerald-400/10"></div>
        <div class="absolute -bottom-28 -left-24 w-80 h-80 rounded-full bg-amber-400/10 blur-3xl"></div>
      </div>

      <div class="relative grid gap-7 md:gap-10 md:grid-cols-2 p-4 sm:p-8 md:p-12 md:items-start">
        <!-- Left -->
        <div class="flex flex-col">
          <!-- Small header pill -->
          <div class="inline-flex items-center justify-center sm:justify-start gap-3 rounded-2xl bg-black/5 dark:bg-white/10 px-4 py-3 w-full sm:w-fit">
            <span class="grid place-items-center w-9 h-9 rounded-xl bg-white/70 dark:bg-gray-900/40 border border-black/5 dark:border-white/10">
              <i class="fas fa-paper-plane"></i>
            </span>
            <span class="font-semibold tracking-wide text-gray-900 dark:text-gray-100">
              {t.pill}
            </span>
          </div>

          <p class="mt-5 sm:mt-6 text-base sm:text-lg leading-relaxed text-gray-700 dark:text-gray-300">
            {t.pitch}
          </p>

          <!-- Tags (ocultos en mobile para que no sea kilométrico) -->
          <div class="hidden sm:flex mt-6 flex-wrap gap-2 justify-center sm:justify-start">
            {t.tags.map((tag) => (
              <span class="rounded-full border border-black/10 dark:border-white/10 bg-white/70 dark:bg-gray-900/40 px-3 py-1 text-xs font-semibold text-gray-700 dark:text-gray-300">
                {tag}
              </span>
            ))}
          </div>

          <!-- CTA Row -->
          <div class="mt-8 flex flex-col sm:flex-row gap-3 sm:items-center">
            <a
              href={mailto}
              class="w-full sm:w-auto inline-flex items-center justify-center gap-3 rounded-xl bg-cerise-600 dark:bg-emerald-600 px-6 py-3 font-semibold text-white hover:bg-cerise-500 dark:hover:bg-emerald-500 transition"
            >
              <i class="fas fa-envelope"></i>
              {t.ctaPrimary}
            </a>

            <a
              href={mailto}
              class="w-full sm:w-auto inline-flex items-center justify-center gap-2 text-sm font-semibold text-gray-700 dark:text-gray-300 hover:text-cerise-600 dark:hover:text-emerald-400 transition break-all text-center"
              title={t.ctaEmailTitle}
            >
              <span class="opacity-90">{EMAIL}</span>
              <i class="fas fa-arrow-right"></i>
            </a>
          </div>

          <p class="mt-4 text-sm text-gray-600 dark:text-gray-400">
            {t.socialNote}
          </p>
        </div>

        <!-- Right -->
        <div class="rounded-2xl border border-black/5 dark:border-white/10 bg-white/60 dark:bg-gray-900/25 p-6">
          <div class="flex flex-col sm:flex-row sm:items-start sm:justify-between gap-3 sm:gap-4">
            <div>
              <h3 class="text-xl font-semibold text-gray-900 dark:text-gray-100">
                {t.rightTitle}
              </h3>
              <p class="mt-2 text-sm text-gray-700 dark:text-gray-300">
                {t.rightDesc}
              </p>
            </div>

            <span class="shrink-0 self-start rounded-xl bg-black/5 dark:bg-white/10 px-3 py-2 text-xs font-semibold text-gray-700 dark:text-gray-200">
              {t.bestChannel}
            </span>
          </div>

          <div class="mt-5 flex flex-wrap gap-4">
            <a
              href={SOCIAL.instagram}
              target="_blank"
              rel="noreferrer"
              class="text-gray-400 hover:text-cerise-600 dark:hover:text-emerald-400 transition-colors"
            >
              <i class="fab fa-instagram fa-lg"></i>
              <span class="sr-only">Instagram</span>
            </a>

            <a
              href={SOCIAL.linkedin}
              target="_blank"
              rel="noreferrer"
              class="text-gray-400 hover:text-cerise-600 dark:hover:text-emerald-400 transition-colors"
            >
              <i class="fab fa-linkedin fa-lg"></i>
              <span class="sr-only">LinkedIn</span>
            </a>

            <a
              href={SOCIAL.github}
              target="_blank"
              rel="noreferrer"
              class="text-gray-400 hover:text-cerise-600 dark:hover:text-emerald-400 transition-colors"
            >
              <i class="fab fa-github fa-lg"></i>
              <span class="sr-only">GitHub</span>
            </a>
          </div>

          <!-- Desktop: full content -->
          <div class="hidden md:block">
            <div class="mt-6 rounded-xl bg-black/5 dark:bg-white/10 p-4">
              <p class="text-sm text-gray-700 dark:text-gray-300">
                {t.rightMessage}
              </p>
            </div>

            <div class="my-6 h-px bg-black/10 dark:bg-white/10"></div>

            <h4 class="text-lg font-semibold text-gray-900 dark:text-gray-100">
              {t.reachOutTitle}
            </h4>

            <ul class="mt-4 space-y-2 text-sm text-gray-700 dark:text-gray-300">
              {t.bullets.map((item) => (
                <li class="flex gap-2">
                  <span class="mt-2 w-1.5 h-1.5 rounded-full bg-cerise-600 dark:bg-emerald-500"></span>
                  {item}
                </li>
              ))}
            </ul>
          </div>

          <!-- Mobile: compact accordion -->
          <details class="md:hidden mt-5 rounded-xl border border-black/10 dark:border-white/10 bg-white/40 dark:bg-gray-900/20">
            <summary class="cursor-pointer select-none px-4 py-3 text-sm font-semibold text-gray-800 dark:text-gray-200">
              {lang === "es" ? "Ver más" : "See more"}
            </summary>

            <div class="px-4 pb-4">
              <div class="mt-2 rounded-xl bg-black/5 dark:bg-white/10 p-4">
                <p class="text-sm text-gray-700 dark:text-gray-300">
                  {t.rightMessage}
                </p>
              </div>

              <div class="my-5 h-px bg-black/10 dark:bg-white/10"></div>

              <h4 class="text-base font-semibold text-gray-900 dark:text-gray-100">
                {t.reachOutTitle}
              </h4>

              <ul class="mt-3 space-y-2 text-sm text-gray-700 dark:text-gray-300">
                {t.bullets.map((item) => (
                  <li class="flex gap-2">
                    <span class="mt-2 w-1.5 h-1.5 rounded-full bg-cerise-600 dark:bg-emerald-500"></span>
                    {item}
                  </li>
                ))}
              </ul>
            </div>
          </details>
        </div>
      </div>
    </div>
  </div>
</section>
